### Copy this file to .env and fill in your MySQL credentials
MONGO_URI=mongodb://127.0.0.1:27017/hrms_db
JWT_SECRET=hrms_secret_key
PORT=5000

# MySQL / Sequelize config
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glisten
DB_USER=root
DB_PASS=your_mysql_password_here

# Optional: set to true to enable Sequelize logging
SEQUELIZE_LOGGING=false
